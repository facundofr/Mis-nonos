{
  "name": "residencia360",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma para residencias de adultos mayores. Piloto: Mis Nonos.",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "check": "eslint . && next typegen && tsc --noEmit && vitest run",
    "db:up": "docker compose -f infra/compose/dev.yaml up -d --wait",
    "db:down": "docker compose -f infra/compose/dev.yaml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "org:create": "tsx scripts/create-organization.ts",
    "worker": "tsx watch worker/index.ts",
    "worker:build": "esbuild worker/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/worker/index.cjs --sourcemap --external:pg-native --log-level=warning",
    "tools:build": "esbuild scripts/migrate.ts scripts/create-organization.ts --bundle --platform=node --target=node24 --format=cjs --outdir=dist/tools --out-extension:.js=.cjs --sourcemap --external:pg-native --log-level=warning",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-pdf/renderer": "4.9.0",
    "better-auth": "1.7.14",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.61.0",
    "next": "16.4.3",
    "next-themes": "0.4.6",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "uqr": "0.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
