# Copiar a .env.local y completar. Los archivos .env* reales nunca se suben
# al repositorio (sección 12.3). Se amplía en cada etapa.

# URL pública de la app (en el VPS, la del subdominio de la app).
APP_URL=http://localhost:3000

# Nivel de los logs: fatal, error, warn, info, debug, trace o silent.
LOG_LEVEL=info

# Base de datos. Los valores de abajo son los de desarrollo
# (infra/compose/dev.yaml) y solo sirven en esta máquina.
# La app usa el rol sin BYPASSRLS; las migraciones, el rol dueño (10.13);
# el worker, además, el rol de la cola (docs/decisions/0005).
DATABASE_URL=postgres://r360_app:app_dev@localhost:5436/residencia360
DATABASE_URL_OWNER=postgres://r360_owner:owner_dev@localhost:5436/residencia360
DATABASE_URL_WORKER=postgres://r360_worker:worker_dev@localhost:5436/residencia360

# Autenticación (Better Auth): firma las cookies y cifra los secretos del
# 2FA; de él se derivan también los enlaces temporales a archivos. Al menos
# 32 caracteres, distinto en cada entorno. Para generarlo:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Si cambia, se cierran todas las sesiones y hay que rehacer los 2FA.
BETTER_AUTH_SECRET=

# 2FA obligatoria para Administración y Dirección (por defecto true).
# REQUIRE_PRIVILEGED_2FA=false

# Email. Sin SMTP_HOST, en desarrollo los emails se muestran en la consola
# del servidor. Con Mailpit (corepack pnpm db:up), se ven en
# http://localhost:8025:
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_SECURITY=none
# En producción: el proveedor transaccional, con SMTP_SECURITY=starttls
# (puerto 587) o tls (puerto 465), y un dominio con SPF, DKIM y DMARC.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Mis Nonos <avisos@ejemplo.com>"

# Carpeta privada de las fotos del legajo (DC-08). En el VPS, un volumen
# con copia cifrada fuera del servidor. Nunca dentro de public/.
STORAGE_DIR=storage

# Landing en la raíz del dominio (docs/decisions/0016): quien entra a "/"
# sin sesión va a /residencia/<dirección>. Vacía: la raíz lleva al ingreso.
# La dirección se elige en Configuración › Formulario público.
HOME_LANDING_SLUG=
